# Settings for the helmreview container. One KEY=value per line; comments only on
# their own line.

# Access token for the web UI, for the Docker service only: uncomment and set it. The Podman units
# take it from the Podman secret `helmreview-token` instead (see their header).
# Generate one with: openssl rand -hex 24  (hex: a "+" would break the ?token= link)
#HELMREVIEW_WEB_TOKEN=

# Default model (qwen2.5-coder:14b) and context size. The model can also be picked
# in the web UI (top bar), which wins over this line.
#HELMREVIEW_MODEL=qwen2.5-coder:14b
#HELMREVIEW_NUM_CTX=16384

# Ollama on another machine (Docker service). With the Podman Quadlet, change the
# Environment=OLLAMA_HOST line in helmreview.container instead.
#OLLAMA_HOST=http://gpu-box.example:11434

# Report language (en or nl) and the severity that marks a scan as failed.
#HELMREVIEW_LANGUAGE=en
#HELMREVIEW_FAIL_ON=high

# Review GitLab merge requests in the background (see https://jwklijnsma.github.io/helmreview/usage/merge-requests/).
# The token needs the api scope. For Podman, a secret keeps it out of this file:
#   printf %s 'glpat-...' | podman secret create helmreview-gitlab-token -
#   and in helmreview.container: Secret=helmreview-gitlab-token,type=env,target=GITLAB_TOKEN
#HELMREVIEW_WATCH_MRS=1
#HELMREVIEW_GITLAB_URL=https://gitlab.example.nl
#HELMREVIEW_GITLAB_PROJECTS=platform/charts,platform/apps
#HELMREVIEW_GITLAB_GROUPS=
#GITLAB_TOKEN=
# An internal CA: mount the bundle and point both at it.
#REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
#GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt
