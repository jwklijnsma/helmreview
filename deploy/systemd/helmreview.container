# helmreview web UI as a Podman Quadlet (RHEL 9/10, Fedora, any Podman >= 4.4).
#
# Rootless, as the user who owns the repositories (recommended):
#   openssl rand -hex 24 | tr -d '\n' | podman secret create helmreview-token -
#   mkdir -p ~/.config/containers/systemd ~/.config/helmreview
#   cp helmreview.container ~/.config/containers/systemd/
#   install -m 600 helmreview.env.example ~/.config/helmreview/helmreview.env   # optional settings
#   systemctl --user daemon-reload
#   systemctl --user start helmreview
#   loginctl enable-linger "$USER"                    # keep it running without a login
#   systemctl --user enable --now podman-auto-update.timer   # daily image updates
#
# Then open http://localhost:8766/?token=<token>; see it again with
#   podman secret inspect --showsecret --format '{{.SecretData}}' helmreview-token
# Logs: journalctl --user -u helmreview -f
#
# As root (/etc/containers/systemd/): use helmreview-rootful.container instead.
# This file does not work rootful: keep-id is rootless-only and %h would be /root.

[Unit]
Description=helmreview: review Helm charts with helm lint and a local Ollama model
Documentation=https://github.com/jwklijnsma/helmreview
Wants=network-online.target
After=network-online.target
# If Ollama runs as a service on this host:
# After=ollama.service

[Container]
ContainerName=helmreview
Image=ghcr.io/jwklijnsma/helmreview:latest
AutoUpdate=registry

# Only on this machine. For another machine use an SSH tunnel or a TLS proxy in front.
PublishPort=127.0.0.1:8766:8766

# The repositories to review: every chart repo in this folder shows up in the UI.
# :z relabels them for SELinux so the container may read and fix them.
Volume=%h/git:/repos:z
# ZIP uploads survive restarts and updates; :U gives the volume to the container user.
Volume=helmreview-data:/home/helmreview/.cache/helmreview:U

# Runs as you inside the container, so reports and fixes in ~/git stay owned by you.
UserNS=keep-id:uid=1000,gid=1000
User=1000
Group=1000

# The access token, from the Podman secret created above.
Secret=helmreview-token,type=env,target=HELMREVIEW_WEB_TOKEN
# Optional settings (model, context size, language); `-` = fine if it is missing.
EnvironmentFile=-%h/.config/helmreview/helmreview.env
# Ollama on this host; change it here for Ollama on another machine. On this host it
# must listen on more than 127.0.0.1 for the container to reach it:
# `systemctl edit ollama` -> [Service] Environment=OLLAMA_HOST=0.0.0.0
Environment=OLLAMA_HOST=http://host.containers.internal:11434

# Nothing in the container needs root powers.
NoNewPrivileges=true
DropCapability=all

HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8766/', timeout=4)"
HealthInterval=30s
HealthStartPeriod=10s
# SIGINT lets running scans and fixes stop cleanly.
StopSignal=SIGINT
StopTimeout=30

[Service]
Restart=on-failure
RestartSec=10
# The first start pulls the image.
TimeoutStartSec=600

[Install]
WantedBy=default.target
